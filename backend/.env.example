# Copy to backend/.env and fill in. .env is git-ignored — never commit it.
# Do NOT put a real key in THIS file: .env.example IS committed to git.

# --- chatbot (Groq) ---
# Get a free key at https://console.groq.com/keys
# Without this, /api/chat returns a labelled "LLM not configured" error.
GROQ_API_KEY=

# Chat models verified available on this project's key (131k context each).
# Check your own key with client.models.list() before changing this —
# Groq keys differ in which models they can reach.
#   openai/gpt-oss-120b  default, best answers, good Arabic
#   openai/gpt-oss-20b   faster
#   qwen/qwen3.8-27b     fastest, no reasoning pass
GROQ_MODEL=openai/gpt-oss-120b

# --- optional overrides (all have working defaults in app/core/config.py) ---
# SESSION_TTL_MINUTES=60
# CORS_ORIGINS=http://localhost:5173
# MIN_TRANSFER_QTY=10
# MAX_DISTANCE_KM=150
